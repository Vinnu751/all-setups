#!/bin/bash

# SonarQube Community Build 26.1.0.118079 - Amazon Linux setup
# Requires: sudo/root access and Java 21 JDK

set -e

SONAR_VERSION="26.1.0.118079"
SONAR_DIR="/opt/sonarqube"
SONAR_USER="sonarqube"
JAVA_BIN="/usr/lib/jvm/java-21-amazon-corretto.x86_64/bin/java"
SONAR_JAR="$SONAR_DIR/lib/sonar-application-${SONAR_VERSION}.jar"

echo "=== 1. Checking Java 21 ==="
if [ ! -x "$JAVA_BIN" ]; then
    echo "ERROR: Java 21 was not found at:"
    echo "$JAVA_BIN"
    echo "Run: readlink -f \$(which java)"
    exit 1
fi

"$JAVA_BIN" -version

echo "=== 2. Creating SonarQube user ==="
if ! id "$SONAR_USER" >/dev/null 2>&1; then
    sudo useradd -r -m -d "$SONAR_DIR" -s /bin/bash "$SONAR_USER"
fi

echo "=== 3. Checking SonarQube installation ==="
if [ ! -f "$SONAR_JAR" ]; then
    echo "ERROR: SonarQube JAR not found:"
    echo "$SONAR_JAR"
    exit 1
fi

echo "=== 4. Fixing ownership ==="
sudo chown -R "$SONAR_USER:$SONAR_USER" "$SONAR_DIR"

echo "=== 5. Configuring kernel parameters ==="
sudo tee /etc/sysctl.d/99-sonarqube.conf >/dev/null <<EOF
vm.max_map_count=524288
fs.file-max=131072
EOF

sudo sysctl --system

echo "=== 6. Configuring user limits ==="
sudo tee /etc/security/limits.d/99-sonarqube.conf >/dev/null <<EOF
$SONAR_USER   -   nofile   131072
$SONAR_USER   -   nproc    8192
EOF

echo "=== 7. Configuring SonarQube web server ==="
SONAR_PROPERTIES="$SONAR_DIR/conf/sonar.properties"

# Uncomment/update these values if they already exist; otherwise append them.
if grep -qE '^[[:space:]]*sonar\.web\.host=' "$SONAR_PROPERTIES"; then
    sudo sed -i 's|^[[:space:]]*sonar\.web\.host=.*|sonar.web.host=0.0.0.0|' "$SONAR_PROPERTIES"
else
    echo "sonar.web.host=0.0.0.0" | sudo tee -a "$SONAR_PROPERTIES" >/dev/null
fi

if grep -qE '^[[:space:]]*sonar\.web\.port=' "$SONAR_PROPERTIES"; then
    sudo sed -i 's|^[[:space:]]*sonar\.web\.port=.*|sonar.web.port=9000|' "$SONAR_PROPERTIES"
else
    echo "sonar.web.port=9000" | sudo tee -a "$SONAR_PROPERTIES" >/dev/null
fi

sudo chown "$SONAR_USER:$SONAR_USER" "$SONAR_PROPERTIES"

echo "=== 8. Creating systemd service ==="
sudo tee /etc/systemd/system/sonarqube.service >/dev/null <<EOF
[Unit]
Description=SonarQube service
After=syslog.target network.target

[Service]
Type=simple
User=$SONAR_USER
Group=$SONAR_USER

ExecStart=$JAVA_BIN -Xms32m -Xmx32m -Djava.net.preferIPv4Stack=true -jar $SONAR_JAR

StandardOutput=journal
StandardError=journal

LimitNOFILE=131072
LimitNPROC=8192

TimeoutStartSec=300
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
EOF

echo "=== 9. Reloading systemd ==="
sudo systemctl daemon-reload

echo "=== 10. Enabling SonarQube at boot ==="
sudo systemctl enable sonarqube

echo "=== 11. Starting SonarQube ==="
sudo systemctl restart sonarqube

echo
echo "SonarQube is starting. This can take 30-60+ seconds."
echo

sleep 10

echo "=== Service status ==="
sudo systemctl --no-pager status sonarqube || true

echo
echo "=== Useful commands ==="
echo "Status : sudo systemctl status sonarqube"
echo "Logs   : sudo journalctl -u sonarqube -n 100 --no-pager"
echo "Restart: sudo systemctl restart sonarqube"
echo "Stop   : sudo systemctl stop sonarqube"
echo
echo "Web UI : http://<EC2-PUBLIC-IP>:9000"
echo "Default login: admin / admin"
